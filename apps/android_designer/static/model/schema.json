{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zxlawdx/Agata/ui-model-v1",
  "title": "Agata semantic Android document v1",
  "type": "object",
  "required": [
    "version",
    "namespace",
    "app_name",
    "start_screen",
    "screens",
    "theme",
    "custom_files"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "app_name": {
      "type": "string"
    },
    "start_screen": {
      "type": "string"
    },
    "screens": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "width",
          "height",
          "position",
          "root"
        ],
        "properties": {
          "root": {
            "$ref": "#/$defs/node"
          }
        }
      }
    },
    "theme": {
      "type": "object"
    },
    "custom_files": {
      "type": "object"
    }
  },
